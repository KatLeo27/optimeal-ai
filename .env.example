# OptiMeal AI Environment Configuration Template
# Copy this file to .env and insert your real credentials (DO NOT commit .env to version control)

# IBM Granite / watsonx.ai API Configuration (Optional)
IBM_GRANITE_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Alternative LLM Providers (Optional for GenAI/RAG, fallback rule-engine active by default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External Weather API (Optional)
OPENWEATHERMAP_API_KEY=

# Application Settings
STREAMLIT_SERVER_PORT=8501
DEMO_MODE=true
